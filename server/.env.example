# ---- 12C MRI Phase 0 — server config ----
# Copy to .env and fill in. The .env file is gitignored.

# HTTP
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Local durable storage (SQLite). Gitignored under server/data/.
DB_PATH=./data/mri.sqlite

# ---- LLM mode ----
# auto | direct | mock
#   direct = your own OpenAI-compatible provider (OpenRouter, OpenAI, …); prompt generated locally.
#   mock   = canned UI, no network.
# auto picks direct if LLM_API_KEY is set, else mock.
LLM_MODE=auto

# ---- External LLM provider (OpenRouter by default) ----
# Bring your own key; data goes to your chosen provider. Leave empty to run in mock mode.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Model id as your provider expects it. OpenRouter examples:
#   openai/gpt-4o-mini, openai/gpt-4o, anthropic/claude-3.5-sonnet
LLM_MODEL=openai/gpt-4o-mini
