# ---- 12C MRI Phase 0 — server config ----
# Copy to .env and fill in. The .env file is gitignored.

# HTTP
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Local durable storage (SQLite). Gitignored under server/data/.
DB_PATH=./data/mri.sqlite

# ---- Thesys OpenUI gateway (Managed free tier) ----
# Create a key at the Thesys console and paste it here.
# While this is empty, the server runs in MOCK gateway mode (no network, canned UI),
# so the frontend + durability can be tested before the key exists.
THESYS_API_KEY=
THESYS_BASE_URL=https://api.thesys.dev/v1/embed

# Gateway model id (provider/model). Swappable without code changes.
MRI_MODEL=openai/gpt-5

# Force mock mode even when a key is present (set to 1 to test offline).
MOCK_GATEWAY=
